{
  "name": "Google Chrome",
  "slug": "google-chrome",
  "description": "Google Chrome web browser",
  "website": "https://google.com/chrome",
  "platform": "macOS",
  "architecture": "universal",
  "min_os": "11.0",
  "auto_updates": true,
  "version_check": {
    "method": "json_api",
    "url": "https://versionhistory.googleapis.com/v1/chrome/platforms/mac/channels/stable/versions/all/releases?filter=endtime=none,fraction=1&order_by=version%20desc",
    "extraction": {
      "type": "json_path",
      "path": "releases[0].version",
      "example": "150.0.7871.187",
      "note": "fraction=1 selects fully rolled-out builds so the reported version matches the public GGRO DMG."
    },
    "headers": {}
  },
  "download": {
    "method": "direct_url",
    "url": "https://dl.google.com/chrome/mac/universal/stable/GGRO/googlechrome.dmg",
    "file_type": "dmg",
    "headers": {}
  },
  "changelog": {
    "method": "web_scrape",
    "url": "https://chromereleases.googleblog.com/",
    "note": "Google Chrome Releases blog with detailed version release notes. Also: https://chromium.googlesource.com/chromium/src/+log for raw commit history."
  },
  "release_date": {
    "method": "json_api_field",
    "url": "https://versionhistory.googleapis.com/v1/chrome/platforms/mac/channels/stable/versions?page_size=1",
    "field": "versions[0].time (ISO 8601 timestamp)"
  },
  "notes": "Prefer fully rolled-out versions (fraction=1). The unfiltered versions API can report a newer milestone still in staged rollout that the public GGRO DMG has not shipped yet. DMG URL is static and always gives the current public stable universal build.",
  "last_updated": "2026-07-24",
  "$schema": "https://raw.githubusercontent.com/evenwebb/macupdater-profiles/main/schema.json",
  "category": "browsers",
  "license": "free",
  "skip": false,
  "bundle_id": "com.google.Chrome",
  "install": {
    "allow_rollout_lag": true
  },
  "icons": {
    "direct_url": "https://raw.githubusercontent.com/evenwebb/macupdater-profiles/main/icons/google-chrome.png"
  }
}
