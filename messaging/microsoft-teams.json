{
  "name": "Microsoft Teams",
  "slug": "microsoft-teams",
  "description": "Team collaboration and video conferencing",
  "website": "https://microsoft.com",
  "platform": "macOS",
  "architecture": "universal",
  "min_os": "macOS 11",
  "auto_updates": true,
  "version_check": {
    "method": "redirect_trace",
    "url": "https://go.microsoft.com/fwlink/?linkid=869428",
    "extraction": {
      "type": "http_redirect",
      "pattern": "Extract version from Location path: production-osx/{version}/MicrosoftTeams.pkg"
    },
    "headers": {}
  },
  "download": {
    "method": "construct_url",
    "file_type": "pkg",
    "headers": {},
    "url": "https://statics.teams.cdn.office.net/production-osx/enterprise/webview2/lkg/MicrosoftTeams.pkg"
  },
  "changelog": {
    "method": "scrape",
    "url": "https://support.microsoft.com/en-us/office/what-s-new-in-microsoft-teams"
  },
  "release_date": {
    "method": "scrape",
    "field": "changelog/support page"
  },
  "notes": "Uses Microsoft AutoUpdate (MAU 2.0). TEAMS10 refers to classic Teams, TEAMS21 refers to new Teams. Disabled 2026-10-05: the fwlink now lands on .../webview2/lkg/MicrosoftTeams.pkg with the version removed from the path, so the redirect no longer carries one. Re-enable once a versioned Teams endpoint exists.",
  "last_updated": "2026-10-05",
  "$schema": "https://raw.githubusercontent.com/evenwebb/macupdater-profiles/main/schema.json",
  "category": "messaging",
  "license": "free",
  "skip": true,
  "bundle_id": "com.microsoft.teams2",
  "alternate_bundle_ids": [
    "com.microsoft.teams"
  ]
}
