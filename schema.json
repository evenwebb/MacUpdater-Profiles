{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "slug",
    "category",
    "license",
    "version_check",
    "download"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "bundle_id": {
      "type": "string"
    },
    "alternate_bundle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional bundle IDs for related apps (Safari extensions, Setapp variants, renamed apps)"
    },
    "icons": {
      "type": "object",
      "description": "Typed icon sources in priority order",
      "properties": {
        "app_store_id": {
          "type": "string",
          "description": "Apple App Store numeric ID for 512px artwork API"
        },
        "direct_url": {
          "type": "string",
          "description": "Static icon URL (CDN, raw GitHub, etc.)"
        },
        "github_repo": {
          "type": "string",
          "description": "GitHub owner/repo for repo avatar fallback"
        },
        "website": {
          "type": "string",
          "description": "App homepage domain for favicon derivation"
        }
      }
    },
    "category": {
      "type": "string",
      "enum": [
        "ai-tools",
        "apple-apps",
        "browsers",
        "cloud-backup",
        "design",
        "developer-tools",
        "email",
        "gaming",
        "media",
        "messaging",
        "notes-writing",
        "office",
        "password-managers",
        "remote-desktop",
        "rss-reading",
        "specialized",
        "utilities",
        "virtualization",
        "vpn-security"
      ]
    },
    "license": {
      "type": "string",
      "enum": [
        "free",
        "paid"
      ]
    },
    "skip": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "platform": {
      "type": "string"
    },
    "architecture": {
      "type": "string"
    },
    "min_os": {
      "type": "string"
    },
    "auto_updates": {
      "type": "boolean"
    },
    "version_check": {
      "type": "object",
      "required": [
        "method",
        "url",
        "extraction"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "extraction": {
          "type": "object"
        },
        "headers": {
          "type": "object"
        },
        "rate_limit": {
          "type": "string"
        }
      }
    },
    "download": {
      "type": "object",
      "required": [
        "method",
        "file_type"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "file_type": {
          "type": "string"
        },
        "headers": {
          "type": "object"
        }
      }
    },
    "changelog": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "release_date": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string"
        },
        "field": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "schema_version": {
      "type": "integer",
      "description": "Profile schema version (currently 2)"
    },
    "installed_version": {
      "type": "object",
      "description": "How MacUpdater should read the installed app version when Info.plist is wrong or incomplete. Omit to use CFBundleShortVersionString/CFBundleVersion only.",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "plist",
            "helper_cli"
          ],
          "description": "plist = Info.plist only (default). helper_cli = run a relative CLI inside the .app (never Contents/MacOS)."
        },
        "path": {
          "type": "string",
          "description": "Bundle-relative executable path, e.g. Contents/Helpers/ctrld"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Arguments passed to the helper (default [\"--version\"])"
        },
        "pattern": {
          "type": "string",
          "description": "Optional regex with a capture group for the version string"
        },
        "when": {
          "type": "string",
          "enum": [
            "plist_placeholder",
            "always"
          ],
          "description": "plist_placeholder (default) only runs when Info.plist looks like 1.0/0; always always prefers the helper"
        },
        "timeout_sec": {
          "type": "number",
          "description": "Helper timeout seconds (clamped 0.5\u201310, default 3)"
        }
      }
    },
    "match": {
      "type": "object",
      "description": "Optional matching policy overrides for this profile.",
      "properties": {
        "mas_primary_only": {
          "type": "boolean",
          "description": "If true (default client behavior), Mac App Store installs only bind when their bundle_id equals this profile's primary bundle_id \u2014 not alternate_bundle_ids. Set false only when a MAS build is intentionally the same product."
        }
      }
    },
    "install": {
      "type": "object",
      "description": "Optional install-time policy for free/direct downloads.",
      "properties": {
        "allow_rollout_lag": {
          "type": "boolean",
          "description": "If true (default), allow installing an archive newer than installed even when the version API is ahead (staged vendor rollouts, e.g. Chrome)."
        }
      }
    }
  },
  "_schema_version": 3
}
