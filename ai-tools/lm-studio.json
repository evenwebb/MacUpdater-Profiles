{
  "name": "LM Studio",
  "slug": "lm-studio",
  "bundle_id": "ai.elementlabs.lmstudio",
  "category": "ai-tools",
  "license": "free",
  "description": "Desktop app for running local LLMs on Mac",
  "website": "https://lmstudio.ai",
  "platform": "macOS",
  "architecture": "separate",
  "min_os": "10.15",
  "auto_updates": false,
  "skip": false,
  "version_check": {
    "method": "json_api",
    "url": "https://formulae.brew.sh/api/cask/lm-studio.json",
    "extraction": {
      "type": "json_path",
      "path": "version",
      "download_path": "url",
      "pattern": "^(\\d+\\.\\d+\\.\\d+)",
      "example": "0.4.20"
    },
    "headers": {}
  },
  "download": {
    "method": "redirect_url",
    "url": "https://installers.lmstudio.ai/darwin/{ARCH}/latest",
    "file_type": "dmg",
    "headers": {},
    "note": "Architecture-aware redirect to versioned DMG. {ARCH} = arm64 or x64."
  },
  "changelog": {
    "method": "web_scrape",
    "url": "https://lmstudio.ai/changelog"
  },
  "release_date": {
    "method": "http_last_modified",
    "url": "download redirect"
  },
  "notes": "bundle_id changed from com.elementlabs.lmstudio to ai.elementlabs.lmstudio. Version check changed from HTML scrape to JSON API.",
  "last_updated": "2026-06-21"
}
