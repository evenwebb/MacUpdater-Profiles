{
  "name": "Sketch",
  "slug": "sketch",
  "description": "Vector design tool for UI/UX designers , symbols, shared styles, prototyping",
  "website": "https://www.sketch.com",
  "platform": "macOS",
  "architecture": "universal",
  "min_os": "macOS 12.0",
  "auto_updates": true,
  "version_check": {
    "method": "json_api",
    "url": "https://formulae.brew.sh/api/cask/sketch.json",
    "extraction": {
      "type": "json_path",
      "path": "version",
      "download_path": "url",
      "pattern": "^(\\d{4}\\.\\d+(?:\\.\\d+)?)",
      "example": "2026.2.1"
    },
    "headers": {}
  },
  "download": {
    "method": "sparkle_enclosure",
    "file_type": "zip",
    "headers": {},
    "url": "https://update.sketch.com/appcast.xml"
  },
  "changelog": {
    "method": "sparkle_appcast",
    "url": "https://update.sketch.com/appcast.xml",
    "notes": "Release notes in <description> or <sparkle:releaseNotesLink> elements within appcast item."
  },
  "release_date": {
    "method": "sparkle_appcast",
    "field": "pubDate"
  },
  "notes": "Mac App Store + direct download. Website download uses Sparkle auto-updater. Subscription model (paid). Appcast feed at update.sketch.com may require user agent header. Download URL obtained from Sparkle enclosure element in appcast.",
  "last_updated": "2026-06-21",
  "$schema": "https://raw.githubusercontent.com/evenwebb/macupdater-profiles/main/schema.json",
  "category": "design",
  "license": "paid",
  "skip": false,
  "bundle_id": "com.bohemiancoding.sketch3"
}
